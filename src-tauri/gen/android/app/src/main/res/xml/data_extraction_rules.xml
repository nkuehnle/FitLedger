<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up only the consistent database snapshot (see src-tauri/src/lib.rs). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="backup/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="backup/" />
    </device-transfer>
</data-extraction-rules>
